---
import { Font } from "astro:assets";
import "../styles/global.css";
import { contacts } from "../data/contacts";
import { priceSpan } from "../data/services";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const home = new URL(withBase(), site).href;
const ogImage = new URL(withBase("og-image.jpg"), site).href;
const [priceMin, priceMax] = priceSpan();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BarberShop",
  "@id": `${home}#barbershop`,
  name: contacts.name,
  url: home,
  image: ogImage,
  logo: new URL(withBase("icon-512.png"), site).href,
  telephone: contacts.phoneHref.replace("tel:", ""),
  address: {
    "@type": "PostalAddress",
    streetAddress: contacts.address,
    addressLocality: contacts.city,
    addressRegion: contacts.region,
    postalCode: contacts.postalCode,
    addressCountry: "UA",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: contacts.geo.lat,
    longitude: contacts.geo.lng,
  },
  hasMap: contacts.mapsUrl,
  openingHours: `Mo-Su ${contacts.opens}-${contacts.closes}`,
  priceRange: `${priceMin}–${priceMax} ₴`,
  currenciesAccepted: "UAH",
  foundingDate: String(contacts.founded),
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: Number(contacts.rating.replace(",", ".")),
    bestRating: 5,
    reviewCount: contacts.reviewCount,
  },
  sameAs: [contacts.instagramUrl, contacts.tiktokUrl],
  potentialAction: {
    "@type": "ReserveAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: contacts.bookingUrl,
      actionPlatform: [
        "https://schema.org/DesktopWebPlatform",
        "https://schema.org/MobileWebPlatform",
      ],
    },
  },
};
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Тема до першого малювання: збережений вибір або системна. Без спалаху білого. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t;
        d.classList.add("js");
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        d.setAttribute("data-theme", t);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={withBase("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("icon-192.png")} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="sitemap" href={withBase("sitemap.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content={contacts.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Логотип Bless Cuts barbershop на чорному тлі" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-onest" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <script>
      // Поява блоків при скролі
      const root = document.documentElement;
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }
      root.classList.add("reveal-ready");
    </script>
  </body>
</html>
