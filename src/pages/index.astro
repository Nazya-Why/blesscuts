---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import Barbers from "../components/Barbers.astro";
import Gallery from "../components/Gallery.astro";
import Certificate from "../components/Certificate.astro";
import Reviews from "../components/Reviews.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import { contacts } from "../data/contacts";
import { minPrice } from "../data/services";

const title = "Bless Cuts — барбершоп у центрі Львова";
const description = `Барбершоп Bless Cuts у центрі Львова: ${contacts.address}. Чоловічі стрижки від ${minPrice("Стрижка голови")} ₴, борода, камуфлювання сивини. Щодня ${contacts.opens}–${contacts.closes}, онлайн-запис.`;
---

<Base title={title} description={description}>
  <a href="#main" class="skip-link">Перейти до вмісту</a>

  <div class="page" id="top">
    <Header />
    <main id="main">
      <Hero />
      <Stats />
      <About />
      <Services />
      <Barbers />
      <Gallery />
      <section class="section pt-0" aria-label="Подарунковий сертифікат і відгуки">
        <div class="wrap grid gap-3 md:gap-5 lg:grid-cols-2">
          <Certificate />
          <Reviews />
        </div>
      </section>
      <Contacts />
    </main>
  </div>

  <Footer />
</Base>
