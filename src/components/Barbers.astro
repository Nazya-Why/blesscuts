---
import Photo from "./Photo.astro";
import { barbers, needs } from "../data/barbers";
import { contacts, external } from "../data/contacts";
import { priceAt } from "../data/services";
import { formatPrice } from "../lib/format";

// Ціна стрижки в кожного майстра — з прайсу його рівня
const haircutRaw = (level: string) => priceAt("Стрижка голови", level) ?? "";
const minHaircut = Math.min(...barbers.map((b) => Number(haircutRaw(b.level).replace(/\D/g, ""))));

// Фільтри підбору: запити з barbers.ts + «найдоступніші» (рахується з прайсу)
const filters = [...needs, { id: "budget", label: `Стрижка за ${minHaircut} ₴` }];
const cards = barbers.map((b) => {
  const cheapest = Number(haircutRaw(b.level).replace(/\D/g, "")) === minHaircut;
  return { ...b, haircut: formatPrice(haircutRaw(b.level)), tags: [...b.needs, ...(cheapest ? ["budget"] : [])] };
});
---

<section id="barbers" class="section bg-section" aria-labelledby="barbers-title">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Майстри</p>
      <h2 id="barbers-title" class="h2 mt-3">Обери свого барбера.</h2>
    </div>

    <!-- Підбір майстра: лише з JS; без нього просто видно всіх -->
    <div class="picker reveal mt-6 md:mt-8" data-picker>
      <p id="picker-label" class="text-[15px] font-semibold">Що тобі потрібно?</p>
      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-labelledby="picker-label">
        <button type="button" class="pick" aria-pressed="true" data-need="all">Усі майстри</button>
        {
          filters.map((f) => (
            <button type="button" class="pick" aria-pressed="false" data-need={f.id}>
              {f.label}
            </button>
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" data-picker-status></p>
    </div>

    <!-- Мобільні: 2 колонки, усі 8 майстрів видно без горизонтального гортання -->
    <ul class="mt-6 grid grid-cols-2 gap-3 md:mt-8 md:gap-5 lg:grid-cols-4">
      {
        cards.map((b, i) => (
          <li class="reveal" style={`--i:${i % 4}`} data-needs={b.tags.join(" ")} data-name={b.name}>
            <article class="barber lift">
              <Photo
                src={`barbers/${b.photo}`}
                alt={`${b.name}, ${b.level.toLowerCase()} Bless Cuts`}
                widths={[240, 360, 480]}
                sizes="(min-width: 1248px) 276px, (min-width: 1024px) 23vw, 46vw"
                class="aspect-7/8 rounded-[16px]"
              />
              <div class="flex flex-1 flex-col px-1.5 pt-3.5 pb-1 md:px-2 md:pt-5">
                <p class="text-[13px] leading-snug font-medium text-ink-2 md:text-[14px]">{b.level}</p>
                <h3 class="mt-1 text-[19px] leading-tight font-semibold tracking-[-0.02em] md:text-[22px]">{b.name}</h3>
                <ul class="mt-2.5 flex flex-wrap gap-1.5" aria-label="Сильні сторони">
                  {b.focus.map((f) => (
                    <li class="chip">{f}</li>
                  ))}
                </ul>
                <p class="mt-3 text-[14px] text-ink-2 md:text-[15px]">
                  Стрижка <span class="font-semibold text-ink tabular-nums">{b.haircut}</span>
                </p>
                <div class="mt-auto pt-4">
                  <a
                    href={b.bookingUrl}
                    {...external}
                    class="btn btn-soft btn-wrap w-full"
                    aria-label={`Записатися до ${b.nameGen}`}
                  >
                    <span class="md:hidden lg:inline xl:hidden">Записатися</span>
                    <span class="hidden md:inline lg:hidden xl:inline">Записатися до {b.nameGen}</span>
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="reveal not-sure">
      <div>
        <p class="text-[19px] leading-tight font-semibold tracking-[-0.02em]">Не знаєш, кого обрати?</p>
        <p class="mt-1.5 text-[15px] leading-normal text-ink-3">
          Запишись до будь-якого вільного майстра й розкажи, який результат хочеш отримати.
        </p>
      </div>
      <a href={contacts.bookingUrl} {...external} class="btn btn-primary btn-lg shrink-0">Записатися онлайн</a>
    </div>
  </div>
</section>

<style>
  .barber {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 8px 8px 10px;
    border-radius: 22px;
    background: var(--card-on-section);
  }
  .chip {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--section);
    font-size: 13px;
    line-height: 1.35;
    color: var(--text-3);
  }

  .picker {
    display: none;
  }
  :global(.js) .picker {
    display: block;
  }
  .pick {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--card-on-section);
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .pick[aria-pressed="true"] {
    background: var(--btn-bg);
    color: var(--btn-text);
  }

  .not-sure {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 16px;
    padding: 24px;
    border-radius: 24px;
    background: var(--card-on-section);
  }

  @media (min-width: 768px) {
    .barber {
      padding: 12px 12px 14px;
      border-radius: 24px;
    }
    .not-sure {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin-top: 20px;
      padding: 28px 28px 28px 32px;
    }
  }
</style>

<script>
  // «Що тобі потрібно?» — показує лише майстрів, які підходять під запит
  const picker = document.querySelector<HTMLElement>("[data-picker]");
  if (picker) {
    const buttons = Array.from(picker.querySelectorAll<HTMLButtonElement>("[data-need]"));
    const status = picker.querySelector<HTMLElement>("[data-picker-status]");
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-needs]"));

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const need = btn.dataset.need ?? "all";
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        const shown: string[] = [];
        for (const item of items) {
          const fits = need === "all" || (item.dataset.needs ?? "").split(" ").includes(need);
          item.hidden = !fits;
          if (fits) shown.push(item.dataset.name ?? "");
        }
        if (status) status.textContent = need === "all" ? "Показано всіх майстрів" : `Підходять: ${shown.join(", ")}`;
      });
    });
  }
</script>
