---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { nav } from "../data/nav";
import { contacts, external } from "../data/contacts";

interface Props {
  /** Сторінка починається з фото на весь екран: шапка над ним прозора з білим текстом */
  overHero?: boolean;
}

const { overHero = false } = Astro.props;
---

<header class:list={["site-header", overHero && "is-over-hero"]} data-site-header>
  <div class="wrap flex h-(--header-h) items-center justify-between gap-3 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a href="#top" class="logo-text justify-self-start" aria-label="Bless Cuts — на початок сторінки">BLESS CUTS</a>

    <nav aria-label="Основна навігація" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 justify-self-end">
      <ThemeToggle class="hidden lg:inline-grid" />
      <a href={contacts.bookingUrl} {...external} class="btn btn-primary hidden lg:inline-flex">Записатися</a>
      <a href={contacts.bookingUrl} {...external} class="btn btn-primary px-[18px] lg:hidden">Запис</a>
      <button
        type="button"
        class="icon-btn -mr-2.5 lg:hidden"
        aria-label="Відкрити меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<!-- Повноекранне мобільне меню. Поза <header>: backdrop-filter шапки ламає position: fixed. -->
<dialog id="mobile-menu" class="mobile-menu" aria-label="Меню">
  <div class="flex min-h-full flex-col">
    <div class="wrap flex h-(--header-h) shrink-0 items-center justify-between">
      <a href="#top" class="logo-text" data-menu-close>BLESS CUTS</a>
      <button type="button" class="icon-btn -mr-2.5" aria-label="Закрити меню" data-menu-close>
        <Icon name="close" size={24} />
      </button>
    </div>

    <nav aria-label="Мобільна навігація" class="wrap pt-6">
      <ul>
        {
          nav.map((item, i) => (
            <li class="mobile-menu__item" style={`--i:${i}`}>
              <a href={item.href} class="mobile-menu__link" data-menu-close>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="wrap mt-auto pt-10 pb-[max(32px,env(safe-area-inset-bottom))]">
      <a href={contacts.bookingUrl} {...external} class="btn btn-primary btn-lg w-full">Записатися онлайн</a>
      <div class="mt-4 flex items-center justify-between gap-4">
        <a href={contacts.phoneHref} class="inline-flex min-h-11 items-center gap-2 font-semibold">
          <Icon name="phone" size={18} />
          {contacts.phone}
        </a>
        <ThemeToggle />
      </div>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: var(--bg);
    }
  }

  /* Над фото першого екрана: прозора, білий текст. Лише з JS — він знімає стан після фото. */
  .site-header {
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  :global(.js) .site-header.is-over-hero {
    --focus: #ffffff;
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  :global(.js) .is-over-hero .logo-text {
    color: #ffffff;
  }
  :global(.js) .is-over-hero .nav-link {
    color: rgb(255 255 255 / 0.8);
  }
  :global(.js) .is-over-hero .nav-link:hover {
    color: #ffffff;
  }
  :global(.js) .is-over-hero :global(.icon-btn) {
    color: #ffffff;
  }
  :global(.js) .is-over-hero .btn-primary {
    background: #ffffff;
    color: #000000;
  }
  @media (hover: hover) {
    :global(.js) .is-over-hero :global(.icon-btn:hover) {
      background: rgb(255 255 255 / 0.14);
    }
  }

  .logo-text {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text);
    white-space: nowrap;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.3s var(--ease);
  }
  .nav-link:hover {
    color: var(--text);
  }

  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-menu[open] {
    animation: menu-in 0.35s var(--ease);
  }

  .mobile-menu__link {
    display: block;
    padding: 10px 0;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text);
  }
  .mobile-menu[open] .mobile-menu__item {
    animation: menu-item-in 0.5s var(--ease) both;
    animation-delay: calc(60ms + var(--i) * 40ms);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  // Шапка прозора, поки під нею фото першого екрана
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (header && hero) {
    // IntersectionObserver працює асинхронно й не змушує браузер перераховувати розкладку.
    // Верхні 64 px вікна — зона шапки: поки фото заходить нижче за неї, шапка прозора.
    new IntersectionObserver(([entry]) => header.classList.toggle("is-over-hero", entry.isIntersecting), {
      rootMargin: "-64px 0px 0px 0px",
    }).observe(hero);
  } else {
    header?.classList.remove("is-over-hero");
  }

  const menu = document.getElementById("mobile-menu") as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]");

  if (menu && opener) {
    opener.addEventListener("click", () => {
      menu.showModal();
      opener.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add("menu-open");
    });

    const reset = () => {
      opener.setAttribute("aria-expanded", "false");
      document.documentElement.classList.remove("menu-open");
    };

    // Esc або закриття іншим шляхом
    menu.addEventListener("close", reset);

    // Пункт меню: закриваємо діалог і одразу розблоковуємо сторінку,
    // щоб браузер без перешкод прокрутив до якоря
    menu.querySelectorAll("[data-menu-close]").forEach((el) => {
      el.addEventListener("click", () => {
        reset();
        menu.close();
      });
    });

    // Повернули телефон / розширили вікно до десктопа — меню не потрібне
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
