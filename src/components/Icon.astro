interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
  /** Зафарбована іконка (зірки рейтингу) */
  filled?: boolean;
}

const { name, size = 20, class: className, filled = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={filled ? "currentColor" : "none"}
  stroke={filled ? "none" : "currentColor"}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={icons[name]}
/>
