---
import { contacts, external } from "../data/contacts";

const steps = [
  { title: "Обери майстра", text: "За рівнем і стилем — від молодшого майстра до арт-директора." },
  { title: "Обери послугу", text: "Усі ціни є на сайті ще до запису." },
  { title: "Обери час", text: "Онлайн, без дзвінків, у будь-який час доби." },
  { title: "Приходь", text: "Решту зробимо ми." },
];
---

<section id="first-visit" class="section" aria-labelledby="first-visit-title">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Вперше у нас?</p>
      <h2 id="first-visit-title" class="h2 mt-3">Чотири кроки до нової стрижки.</h2>
    </div>

    <ol class="mt-8 grid gap-3 sm:grid-cols-2 md:mt-12 md:gap-4 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="step reveal" style={`--i:${i}`}>
            <span class="step__num" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-5 text-[19px] leading-tight font-semibold tracking-[-0.02em]">{s.title}</h3>
            <p class="mt-1.5 text-[15px] leading-normal text-ink-3">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-8 flex flex-col items-start gap-4 md:mt-10 md:flex-row md:items-center md:justify-between">
      <p class="max-w-[36rem] text-[17px] leading-normal text-ink-3">
        Не знаєш, що тобі підійде? Просто розкажи майстру, який результат хочеш отримати.
      </p>
      <a href={contacts.bookingUrl} {...external} class="btn btn-primary btn-lg shrink-0">Записатися онлайн</a>
    </div>
  </div>
</section>

<style>
  .step {
    padding: 24px;
    border-radius: 24px;
    background: var(--card);
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
