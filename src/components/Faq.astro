---
import Icon from "./Icon.astro";
import { faq } from "../data/faq";
import { contacts } from "../data/contacts";
---

<section id="faq" class="section bg-section" aria-labelledby="faq-title">
  <div class="wrap grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
    <div class="reveal">
      <p class="eyebrow">Часті питання</p>
      <h2 id="faq-title" class="h2 mt-3">Коротко про головне.</h2>
      <p class="mt-4 max-w-[24rem] text-[17px] leading-normal text-ink-3">
        Не знайшов відповіді? Подзвони — <a href={contacts.phoneHref} class="font-semibold whitespace-nowrap text-ink underline decoration-line underline-offset-4">{contacts.phone}</a>.
      </p>
    </div>

    <div class="reveal grid gap-3" style="--i:1">
      {
        faq.map((item) => (
          <details class="qa">
            <summary>
              <span>{item.q}</span>
              <Icon name="plus" size={20} class="qa__icon shrink-0" />
            </summary>
            <p class="qa__answer">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .qa {
    border-radius: 22px;
    background: var(--card-on-section);
  }
  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 16px 20px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    border-radius: 22px;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa :global(.qa__icon) {
    color: var(--text-2);
    transition: transform 0.35s var(--ease);
  }
  .qa[open] :global(.qa__icon) {
    transform: rotate(45deg);
  }
  .qa__answer {
    padding: 0 20px 20px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-3);
  }
  .qa[open] .qa__answer {
    animation: qa-in 0.35s var(--ease);
  }

  @media (min-width: 768px) {
    .qa summary {
      padding: 18px 24px;
    }
    .qa__answer {
      padding: 0 24px 22px;
    }
  }

  @keyframes qa-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
