---
import Icon from "./Icon.astro";
import { contacts, external, reviewsLabel } from "../data/contacts";
import { reviews } from "../data/reviews";
---

<section id="reviews" class="section bg-section" aria-labelledby="reviews-title">
  <div class="wrap">
    <div class="reviews reveal">
      <p class="eyebrow">Відгуки</p>

      <p class="mt-6 flex items-baseline justify-center gap-2 leading-none font-bold md:mt-8" aria-hidden="true">
        <span class="text-[96px] tracking-[-0.05em] tabular-nums md:text-[144px]">{contacts.rating}</span>
        <span class="text-[28px] tracking-[-0.02em] text-ink-2 md:text-[36px]">з 5</span>
      </p>

      <div class="mt-5 flex justify-center gap-1 text-ink" aria-hidden="true">
        {Array.from({ length: 5 }, () => <Icon name="star" size={24} filled />)}
      </div>

      <h2 id="reviews-title" class="h3 mt-6">
        <span class="sr-only">Оцінка {contacts.rating} з 5 · </span>{reviewsLabel} відгуків у Google.
      </h2>
      <p class="mx-auto mt-3 max-w-[30rem] text-[17px] leading-normal text-ink-3">
        Середня оцінка від клієнтів, які вже були в Bless Cuts. Ось що вони пишуть:
      </p>

      <!-- Справжні відгуки з Google Maps (src/data/reviews.ts) -->
      <ul class="mt-8 grid gap-3 text-left md:mt-10 md:grid-cols-3 md:gap-4">
        {
          reviews.map((r) => (
            <li class="review">
              <div class="flex gap-0.5 text-ink" aria-label="5 з 5">
                {Array.from({ length: 5 }, () => <Icon name="star" size={16} filled />)}
              </div>
              <blockquote class="mt-3 flex-1 text-[15px] leading-normal text-ink-3">«{r.text}»</blockquote>
              <p class="mt-4 text-[14px] text-ink-2">
                <span class="font-semibold text-ink">{r.name}</span> · відгук у Google
              </p>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row md:mt-10">
        <a href={contacts.bookingUrl} {...external} class="btn btn-primary btn-lg">Записатися онлайн</a>
        <a href={contacts.mapsUrl} {...external} class="btn btn-secondary btn-lg">
          Читати відгуки <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews {
    padding: 40px 24px;
    border-radius: 28px;
    background: var(--card-on-section);
    text-align: center;
  }
  .reviews .btn-secondary {
    background: var(--section);
  }
  .review {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border-radius: 22px;
    background: var(--section);
  }
  @media (min-width: 768px) {
    .reviews {
      padding: 64px 48px;
      border-radius: 32px;
    }
  }
</style>
