---
import Icon from "./Icon.astro";
import { contacts, external } from "../data/contacts";
---

<article class="reviews reveal" style="--i:1" aria-labelledby="reviews-title">
  <h2 class="eyebrow" id="reviews-title">Відгуки</h2>

  <p class="mt-6 leading-none font-bold md:mt-8">
    <span class="text-[96px] tracking-[-0.05em] tabular-nums md:text-[128px]">{contacts.rating}</span>
    <span class="ml-1 text-[28px] tracking-[-0.02em] text-ink-2 md:ml-2 md:text-[34px]">з 5</span>
  </p>

  <div class="mt-5 flex gap-1 text-ink" aria-hidden="true">
    {Array.from({ length: 5 }, () => <Icon name="star" size={22} filled />)}
  </div>

  <p class="mt-5 max-w-[26rem] text-[17px] leading-normal text-ink-3">
    Середня оцінка Bless Cuts від клієнтів у Google&nbsp;Maps.
  </p>

  <div class="mt-auto pt-6">
    <a href={contacts.mapsUrl} {...external} class="link-arrow">
      Читати відгуки <Icon name="arrow" size={18} />
    </a>
  </div>
</article>

<style>
  .reviews {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 24px 24px;
    border-radius: 28px;
    background: var(--card);
    text-align: center;
  }
  @media (min-width: 768px) {
    .reviews {
      padding: 48px 48px 36px;
      border-radius: 32px;
    }
  }
</style>
