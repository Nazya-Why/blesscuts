---
// Перший екран: фоном на весь екран відео залу під затемненням, поверх — білий текст і кнопки.
// Портретні екрани (телефони): вертикальне відео hero.mp4 (720×1280).
// Альбомні (ноутбуки): hero-wide.mp4 — центральна смуга того самого відео, заздалегідь збільшена
// до 1920×1080 (Lanczos + різкість) і стиснута м'якше: чіткіше, ніж розтягування браузером.
import Icon from "./Icon.astro";
import { heroPoster, heroPosterWide } from "../lib/hero-media";
// ?url — Vite кладе файл у /_astro/ з хешем вмісту в назві: нова версія відео не застрягне в кеші
import heroVideo from "../assets/video/hero.mp4?url";
import heroVideoWide from "../assets/video/hero-wide.mp4?url";
import { contacts, external, reviewsLabel } from "../data/contacts";
import { barbers } from "../data/barbers";
import { minPrice } from "../data/services";

const [poster, posterWide] = await Promise.all([heroPoster(), heroPosterWide()]);
---

<section class="hero on-black" data-hero aria-labelledby="hero-title">
  <!-- Обкладинка — перший кадр відповідного відео; видно, доки відео не почне грати -->
  <picture class="hero__poster" aria-hidden="true">
    {posterWide && <source media="(orientation: landscape)" type="image/webp" srcset={posterWide.srcSet.attribute} sizes="100vw" />}
    {poster && <img src={poster.src} alt="" width="720" height="1280" fetchpriority="high" decoding="async" />}
  </picture>

  <!-- Відео без звуку; джерело під орієнтацію екрана й запуск — у скрипті нижче -->
  <video
    class="hero__video"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    data-hero-video
    data-src-portrait={heroVideo}
    data-src-landscape={heroVideoWide}
  ></video>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="wrap hero__content">
    <!-- Дві пігулки: рейтинг і живий статус роботи з маячком -->
    <div class="flex flex-wrap gap-2">
      <a href={contacts.mapsUrl} {...external} class="hero__badge">
        <Icon name="star" size={15} filled />
        <span><span class="font-semibold">{contacts.rating}</span> · {reviewsLabel} відгуків у Google</span>
      </a>
      <p
        class="hero__badge hero__status"
        data-open-status
        data-format="short"
        data-opens={contacts.opens}
        data-closes={contacts.closes}
      >
        <span class="hero__dot" aria-hidden="true"></span>
        <span data-status-text>Щодня {contacts.opens}–{contacts.closes}</span>
      </p>
    </div>

    <h1 id="hero-title" class="h1 mt-5 max-w-[14ch] md:mt-6">Барбершоп у&nbsp;центрі Львова.</h1>

    <p class="mt-4 max-w-[34rem] text-[17px] leading-normal text-white md:mt-5 md:text-[21px]">
      Чоловічі стрижки, борода й камуфлювання сивини на площі Данила Галицького. {barbers.length} майстрів,
      стрижка&nbsp;— від&nbsp;{minPrice("Стрижка голови")}&nbsp;₴.
    </p>

    <div class="mt-7 flex flex-wrap gap-3 md:mt-9" data-hero-cta>
      <a href={contacts.bookingUrl} {...external} class="btn btn-light btn-lg">Записатися онлайн</a>
      <a href="#services" class="btn btn-glass btn-lg">Ціни</a>
    </div>
  </div>
</section>

<style>
  /* Фото заходить під прозору шапку: секція піднята на висоту шапки */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: max(560px, 100vh);
    min-height: clamp(560px, 100svh, 960px);
    margin-top: calc(-1 * var(--header-h));
    overflow: hidden;
    background: #000;
    color: #fff;
  }
  .hero__poster,
  .hero__video,
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  /* Відео — фон на весь екран на будь-якому пристрої; під ним обкладинка */
  .hero__poster img,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Рівномірне затемнення (без градієнтів): білий текст читається навіть над світлими ділянками */
  .hero__scrim {
    background: rgb(0 0 0 / 0.55);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 32px);
    padding-bottom: 40px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 16px 0 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    transition: transform 0.3s var(--ease);
  }
  @media (hover: hover) {
    a.hero__badge:hover {
      transform: scale(1.02);
    }
  }

  /* Маячок у пігулці статусу: зелений і блимає, коли відкрито; помаранчевий, коли зачинено */
  .hero__status {
    gap: 9px;
    padding-left: 13px;
  }
  .hero__dot {
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
  }
  .hero__status[data-state="open"] .hero__dot {
    background: #30d158;
    animation: dot-blink 2s ease-in-out infinite;
  }
  .hero__status[data-state="open"] .hero__dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #30d158;
    animation: dot-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .hero__status[data-state="closed"] .hero__dot {
    background: #ff9f0a;
  }

  @media (min-width: 768px) {
    .hero__content {
      padding-bottom: 64px;
    }
  }
  @media (min-width: 1024px) {
    .hero__content {
      padding-bottom: 88px;
    }
  }

  @keyframes dot-blink {
    50% {
      background-color: rgb(48 209 88 / 0.45);
    }
  }
  @keyframes dot-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    75%,
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }
</style>

<script>
  import "../scripts/open-status";

  // Відео першого екрана: вантажимо лише після сторінки (спершу видно обкладинку),
  // граємо, тільки коли воно в полі зору; поважаємо «зменшити рух» і економію трафіку.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
    .connection;
  const lowData = connection?.saveData === true || /(^|-)2g$/.test(connection?.effectiveType ?? "");

  if (video && !lowData) {
    video.muted = true;
    let onScreen = true;
    let pageLoaded = false;

    // Телефон (портрет) — вертикальне відео, ноутбук (альбом) — широке 1080p
    const landscape = window.matchMedia("(orientation: landscape)");
    const wantedSrc = () => (landscape.matches ? video.dataset.srcLandscape : video.dataset.srcPortrait) ?? "";

    const sync = () => {
      if (!pageLoaded) return;
      if (onScreen && !reducedMotion.matches) {
        const src = wantedSrc();
        if (video.getAttribute("src") !== src) video.src = src;
        video.play().catch(() => {});
      } else if (!video.paused) {
        video.pause();
      }
    };

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(video);
    reducedMotion.addEventListener("change", sync);
    landscape.addEventListener("change", sync);

    // Запуск декодера відео — важка операція; відкладаємо її, поки сторінка «оживає».
    // До старту видно обкладинку — той самий перший кадр, тож затримки не помітно.
    const start = () => {
      const go = () => {
        pageLoaded = true;
        sync();
      };
      setTimeout(() => {
        if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 2000 });
        else go();
      }, 1200);
    };
    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>
