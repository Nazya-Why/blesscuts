---
// Перший екран: фон на весь екран із затемненням, поверх — білий текст і кнопки.
// Портретні екрани (телефони): фоном вертикальне відео залу (src/assets/video/hero.mp4).
// Альбомні (ноутбуки): фоном широке фото залу (hero-wide), а відео — вертикальна картка праворуч.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { asset } from "../lib/images";
import { heroPoster } from "../lib/hero-media";
// ?url — Vite кладе файл у /_astro/ з хешем вмісту в назві: нова версія відео не застрягне в кеші телефона
import heroVideo from "../assets/video/hero.mp4?url";
import { contacts, external, reviewsLabel } from "../data/contacts";
import { barbers } from "../data/barbers";
import { minPrice } from "../data/services";

const wide = asset("hero-wide");

async function variants(image: ImageMetadata, widths: number[]) {
  const fit = widths.filter((w) => w <= image.width);
  const [avif, webp, jpg] = await Promise.all(
    (["avif", "webp", "jpg"] as const).map((format) => getImage({ src: image, widths: fit, format })),
  );
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, jpg };
}

const wideSet = wide ? await variants(wide, [960, 1280, 1600]) : null;
const poster = await heroPoster();
// На портретних екранах <img> лишається порожнім пікселем — широке фото там не завантажується
const blank = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
---

<section class="hero on-black" data-hero aria-labelledby="hero-title">
  {
    wideSet && (
      <picture class="hero__media">
        <source media="(orientation: landscape)" type="image/avif" srcset={wideSet.avif} sizes="100vw" />
        <source media="(orientation: landscape)" type="image/webp" srcset={wideSet.webp} sizes="100vw" />
        <source media="(orientation: landscape)" srcset={wideSet.jpg.srcSet.attribute} sizes="100vw" />
        <img src={blank} alt="" width={wide?.width} height={wide?.height} fetchpriority="high" decoding="async" />
      </picture>
    )
  }

  <!-- Відео без звуку; запускає скрипт після завантаження сторінки (не при «зменшити рух» чи економії трафіку) -->
  <video
    class="hero__video"
    muted
    loop
    playsinline
    preload="none"
    poster={poster?.src}
    aria-hidden="true"
    tabindex="-1"
    data-hero-video
  >
    <source src={heroVideo} type="video/mp4" />
  </video>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="wrap hero__content">
    <a href={contacts.mapsUrl} {...external} class="hero__badge">
      <Icon name="star" size={15} filled />
      <span><span class="font-semibold">{contacts.rating}</span> · {reviewsLabel} відгуків у Google</span>
    </a>

    <h1 id="hero-title" class="h1 mt-5 max-w-[14ch] md:mt-6">Барбершоп у&nbsp;центрі Львова.</h1>

    <p class="mt-4 max-w-[34rem] text-[17px] leading-normal text-white md:mt-5 md:text-[21px]">
      Чоловічі стрижки, борода й камуфлювання сивини на площі Данила Галицького. {barbers.length} майстрів,
      стрижка&nbsp;— від&nbsp;{minPrice("Стрижка голови")}&nbsp;₴.
    </p>

    <div class="mt-7 flex flex-wrap gap-3 md:mt-9" data-hero-cta>
      <a href={contacts.bookingUrl} {...external} class="btn btn-light btn-lg">Записатися онлайн</a>
      <a href="#services" class="btn btn-glass btn-lg">Ціни</a>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-[15px] text-white md:mt-6">
      <p class="hero__status" data-open-status data-opens={contacts.opens} data-closes={contacts.closes}>
        <span class="hero__dot" aria-hidden="true"></span>
        <span data-status-text>Щодня {contacts.opens} — {contacts.closes}</span>
      </p>
      <p class="flex items-center gap-2">
        <Icon name="check" size={18} class="shrink-0" />
        Без дзвінків — запис онлайн
      </p>
    </div>
  </div>
</section>

<style>
  /* Фото заходить під прозору шапку: секція піднята на висоту шапки */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: max(560px, 100vh);
    min-height: clamp(560px, 100svh, 960px);
    margin-top: calc(-1 * var(--header-h));
    overflow: hidden;
    background: #000;
    color: #fff;
  }
  .hero__media,
  .hero__video,
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media {
    display: none;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-zoom 1.8s var(--ease) both;
  }
  /* Портрет: відео — фон на весь екран */
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
  }

  /* Альбом: фоном фото; відео ховається або стає вертикальною карткою праворуч */
  @media (orientation: landscape) {
    .hero__media {
      display: block;
    }
    .hero__video {
      display: none;
    }
  }
  @media (orientation: landscape) and (min-width: 1024px) and (min-height: 640px) {
    .hero__video {
      display: block;
      inset: auto;
      right: max(24px, calc((100% - 1200px) / 2));
      bottom: 88px;
      z-index: 1;
      width: auto;
      height: min(62vh, 560px);
      aspect-ratio: 9 / 16;
      border: 1px solid rgb(255 255 255 / 0.18);
      border-radius: 28px;
      box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
    }
  }
  /* Рівномірне затемнення (без градієнтів): білий текст читається навіть над світлими ділянками */
  .hero__scrim {
    background: rgb(0 0 0 / 0.55);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 32px);
    padding-bottom: 40px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 16px 0 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    transition: transform 0.3s var(--ease);
  }
  @media (hover: hover) {
    .hero__badge:hover {
      transform: scale(1.02);
    }
  }

  /* Маячок: зелений і блимає, коли відкрито; помаранчевий, коли зачинено */
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
  }
  .hero__dot {
    position: relative;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
  }
  .hero__status[data-state="open"] .hero__dot {
    background: #30d158;
    animation: dot-blink 2s ease-in-out infinite;
  }
  .hero__status[data-state="open"] .hero__dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #30d158;
    animation: dot-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .hero__status[data-state="closed"] .hero__dot {
    background: #ff9f0a;
  }

  @media (min-width: 768px) {
    .hero__content {
      padding-bottom: 64px;
    }
  }
  @media (min-width: 1024px) {
    .hero__content {
      padding-bottom: 88px;
    }
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes dot-blink {
    50% {
      background-color: rgb(48 209 88 / 0.45);
    }
  }
  @keyframes dot-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    75%,
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }
</style>

<script>
  import "../scripts/open-status";

  // Відео першого екрана: вантажимо лише після сторінки (спершу видно обкладинку),
  // граємо, тільки коли воно показане й видиме; поважаємо «зменшити рух» і економію трафіку.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  if (video && !saveData) {
    video.muted = true;
    let onScreen = true;
    let pageLoaded = false;

    // Ті самі умови, що й у CSS: фон на портретних екранах або картка на великих альбомних
    const shownQuery = window.matchMedia(
      "(orientation: portrait), (orientation: landscape) and (min-width: 1024px) and (min-height: 640px)",
    );

    const sync = () => {
      if (!pageLoaded) return;
      const shown = shownQuery.matches;
      if (shown && onScreen && !reducedMotion.matches) {
        if (video.preload !== "auto") video.preload = "auto";
        video.play().catch(() => {});
      } else if (!video.paused) {
        video.pause();
      }
    };

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(video);
    reducedMotion.addEventListener("change", sync);
    shownQuery.addEventListener("change", sync);

    const start = () => {
      pageLoaded = true;
      sync();
    };
    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>
