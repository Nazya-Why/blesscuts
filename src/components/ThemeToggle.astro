---
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={["icon-btn theme-toggle", className]}
  data-theme-toggle
  aria-label="Темна тема"
  aria-pressed="false"
>
  <Icon name="moon" class="theme-toggle__moon" />
  <Icon name="sun" class="theme-toggle__sun" />
</button>

<style is:global>
  /* У світлій темі показуємо місяць (увімкнути темну), у темній — сонце */
  :root[data-theme="dark"] .theme-toggle__moon,
  :root:not([data-theme="dark"]) .theme-toggle__sun {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const COLORS = { light: "#ffffff", dark: "#000000" } as const;
  type Theme = keyof typeof COLORS;

  const stored = (): Theme | null => {
    try {
      const t = localStorage.getItem("theme");
      return t === "light" || t === "dark" ? t : null;
    } catch {
      return null;
    }
  };

  function sync(theme: Theme, explicit: boolean) {
    document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(theme === "dark"));
    });
    // Явний вибір перекриває системну тему і для панелі браузера
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
      const own = meta.getAttribute("media")?.includes("dark") ? COLORS.dark : COLORS.light;
      meta.setAttribute("content", explicit ? COLORS[theme] : own);
    });
  }

  function apply(theme: Theme, explicit: boolean) {
    root.classList.add("theme-switching");
    root.setAttribute("data-theme", theme);
    sync(theme, explicit);
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("theme-switching")));
  }

  sync(root.getAttribute("data-theme") === "dark" ? "dark" : "light", stored() !== null);

  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next: Theme = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("theme", next);
      } catch {}
      apply(next, true);
    });
  });

  // Поки користувач нічого не обрав — слідуємо за системою
  media.addEventListener("change", (e) => {
    if (!stored()) apply(e.matches ? "dark" : "light", false);
  });
</script>
